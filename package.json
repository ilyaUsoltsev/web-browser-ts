{
  "name": "wbe-ts",
  "version": "1.0.0",
  "description": "Web Browser Engineering (browser.engineering), followed in TypeScript",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch --include './*.css' --include './*.html' src/main.ts",
    "server": "tsx watch server/server.ts",
    "dev:all": "concurrently -k -n server,browser -c blue,green \"npm:server\" \"wait-on tcp:8000 && tsx watch src/main.ts http://localhost:8000/\"",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "^5.3.0",
    "skia-canvas": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "private": true,
  "type": "module"
}
